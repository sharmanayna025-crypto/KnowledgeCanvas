# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Leave as is unless you want a different model (run: python list_models.py)
GEMINI_MODEL=gemini-3.8-flash

# Must match app.jwt.secret in the Spring backend so one login works for both.
JWT_SECRET=knowledgecanvas_secret_key_123456789

# Set to false only for local experiments without the Spring backend.
AUTH_REQUIRED=true

DATABASE_URL=sqlite:///./documind.db
MAX_UPLOAD_MB=25
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
